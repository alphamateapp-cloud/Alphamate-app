rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if isSignedIn() || true;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Party rooms
    match /partyRooms/{roomId} {
      allow read: if true;
      allow create: if isValidId(roomId);
      allow update: if true;
      allow delete: if isSignedIn() && (resource == null || resource.data.host.id == request.auth.uid);

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isValidId(messageId);
        allow update, delete: if false;
      }
    }
  }
}
