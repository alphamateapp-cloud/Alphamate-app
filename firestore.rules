rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOfficialAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'alphamateapp@gmail.com';
    }

    function isValidAccountDeletionRequest(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'type', 'status', 'requestedAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'uniqueId', 'username', 'displayName', 'email', 'avatar',
          'type', 'status', 'otpVerified', 'otpVerifiedAt', 'requestedAt',
          'scheduledPermanentDeletionAt', 'reason', 'recoveredAt', 'permanentlyDeletedAt',
          'processedBy', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 128
        && data.displayName is string && data.displayName.size() <= 128
        && data.type in ['deactivation', 'permanent_delete']
        && data.status in ['deactivated', 'pending_official_deletion', 'recovered', 'permanently_deleted']
        && data.requestedAt is string && data.requestedAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('otpVerified' in data) || data.otpVerified is bool)
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 500));
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['recipientId', 'senderId', 'type', 'title', 'message', 'isRead', 'createdAt', 'createdAtMs'])
        && data.keys().hasOnly([
          'recipientId', 'senderId', 'senderName', 'senderAvatar', 'type', 'category',
          'title', 'message', 'screen', 'tab', 'roomId', 'streamId', 'reelId', 'chatId',
          'isRead', 'readAt', 'createdAt', 'createdAtMs'
        ])
        && data.recipientId is string && data.recipientId.size() > 0 && data.recipientId.size() <= 128
        && data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128
        && data.type in [
          'live_on', 'live_invite', 'party_invite', 'friend_request', 'follow', 'gift',
          'comment', 'message', 'like', 'pk_invite', 'wallet', 'agency', 'system'
        ]
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.message is string && data.message.size() > 0 && data.message.size() <= 600
        && data.isRead is bool
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.createdAtMs is number;
    }

    function isValidGiftTransaction(data) {
      return data.keys().hasAll([
          'senderId', 'recipientId', 'giftId', 'giftName', 'quantity',
          'totalCoins', 'hostDiamonds', 'appShareCoins', 'context', 'status',
          'createdAt', 'createdAtMs'
        ])
        && data.keys().hasOnly([
          'senderId', 'senderName', 'recipientId', 'recipientName', 'giftId', 'giftName', 'giftIcon',
          'quantity', 'totalCoins', 'hostDiamonds', 'appShareCoins', 'context',
          'roomId', 'streamId', 'reelId', 'status', 'createdAt', 'createdAtMs'
        ])
        && data.senderId == request.auth.uid
        && data.recipientId is string && data.recipientId.size() > 0 && data.recipientId.size() <= 128
        && data.giftId is string && data.giftId.size() > 0 && data.giftId.size() <= 64
        && data.giftName is string && data.giftName.size() > 0 && data.giftName.size() <= 80
        && data.quantity is number && data.quantity >= 1 && data.quantity <= 9999
        && data.totalCoins is number && data.totalCoins > 0 && data.totalCoins <= 50000000
        && data.hostDiamonds is number && data.hostDiamonds >= 0
        && data.appShareCoins is number && data.appShareCoins >= 0
        && (data.hostDiamonds + data.appShareCoins) == data.totalCoins
        && data.context in ['live', 'party', 'moments', 'pk', 'demo']
        && data.status == 'completed'
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.createdAtMs is number;
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId)
        || isOfficialAdmin()
        || (
          isSignedIn()
          && isValidId(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['diamonds', 'updatedAt'])
          && request.resource.data.diamonds is number
          && (!('diamonds' in resource.data) || resource.data.diamonds is number)
          && request.resource.data.diamonds > (('diamonds' in resource.data) ? resource.data.diamonds : 0)
          && request.resource.data.diamonds <= (('diamonds' in resource.data) ? resource.data.diamonds : 0) + 5000000
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 64
        );
      allow delete: if false;

      // Per-user real-time notifications inbox
      match /notifications/{notificationId} {
        allow get: if isValidId(userId) && isValidId(notificationId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isSignedIn()
          && isValidId(userId)
          && isValidId(notificationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.recipientId == userId
          && isValidNotification(request.resource.data);
        allow update: if isValidId(userId)
          && isValidId(notificationId)
          && isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt'])
          && request.resource.data.isRead is bool;
        allow delete: if isValidId(userId) && isValidId(notificationId) && isOwner(userId);
      }
    }

    // Immutable 60/40 Gifting Ledger (60% Host Diamonds, 40% App Revenue Share)
    match /giftTransactions/{txId} {
      allow get: if isValidId(txId)
        && isSignedIn()
        && (isOfficialAdmin() || resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow list: if isSignedIn()
        && (isOfficialAdmin() || resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if isValidId(txId)
        && isSignedIn()
        && isValidGiftTransaction(request.resource.data);
      allow update, delete: if false;
    }

    // Account Deactivation & 15-Day Official Permanent Deletion Queue
    match /accountDeletionRequests/{requestId} {
      allow get: if isValidId(requestId) && (isOwner(requestId) || isOfficialAdmin());
      allow list: if isSignedIn() && (isOfficialAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isValidId(requestId)
        && isOwner(requestId)
        && request.resource.data.uid == request.auth.uid
        && isValidAccountDeletionRequest(request.resource.data);
      allow update: if isValidId(requestId)
        && isValidAccountDeletionRequest(request.resource.data)
        && (
          (isOwner(requestId) && request.resource.data.uid == resource.data.uid)
          || isOfficialAdmin()
        );
      allow delete: if false;
    }


    // Alpha Mate private and group chat
    function chatMember(chatId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds && (!('memberStatus' in get(/databases/$(database)/documents/chats/$(chatId)).data) || get(/databases/$(database)/documents/chats/$(chatId)).data.memberStatus[request.auth.uid] == 'joined');
    }
    match /chatRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.status == 'pending';
      allow get, list: if isSignedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','chatId','updatedAt'])
        && request.resource.data.status in ['accepted','rejected','blocked'];
      allow delete: if false;
    }
    match /chats/{chatId} {
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() >= 2
        && request.resource.data.participantIds.size() <= 101;
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow update: if isSignedIn() && request.resource.data.participantIds == resource.data.participantIds
        && ((request.auth.uid in resource.data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastSenderId','updatedAt','unreadBy','memberStatus']))
          || (resource.data.memberStatus[request.auth.uid] == 'invited'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberStatus','updatedAt'])
            && request.resource.data.memberStatus[request.auth.uid] in ['joined','declined']));
      allow delete: if false;
      match /messages/{messageId} {
        allow get, list: if chatMember(chatId);
        allow create: if chatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000;
        allow update: if chatMember(chatId)
          && (resource.data.senderId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy','deliveredTo','deletedFor']));
        allow delete: if false;
      }
    }
    match /groupInvites/{inviteId} {
      allow create: if isSignedIn() && request.resource.data.inviterId == request.auth.uid;
      allow get, list: if isSignedIn() && (resource.data.inviteeId == request.auth.uid || resource.data.inviterId == request.auth.uid);
      allow update: if isSignedIn() && resource.data.inviteeId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
        && request.resource.data.status in ['accepted','declined'];
      allow delete: if false;
    }
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    match /users/{userId}/blockedUsers/{blockedId} {
      allow read, write: if isOwner(userId);
    }

    // Party rooms
    match /partyRooms/{roomId} {
      allow get: if isValidId(roomId) && (isSignedIn() || resource.data.isActive == true);
      allow list: if isSignedIn() || resource.data.isActive == true;
      allow create: if isSignedIn() && isValidId(roomId) && request.resource.data.host.id == request.auth.uid;
      allow update: if isSignedIn() && isValidId(roomId) && (
        resource.data.host.id == request.auth.uid
        || (resource.data.moderatorIds is list && request.auth.uid in resource.data.moderatorIds)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats', 'updatedAt', 'activeViewers', 'totalGiftCoins', 'lastSeenAtMs'])
      );
      allow delete: if isSignedIn() && isValidId(roomId) && resource.data.host.id == request.auth.uid;

      match /stats/{statId} {
        allow read: if isSignedIn() || get(/databases/$(database)/documents/partyRooms/$(roomId)).data.isActive == true;
        allow create: if isSignedIn() && statId == 'hearts' && request.resource.data.count == 1;
        allow update: if isSignedIn() && statId == 'hearts'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt'])
          && request.resource.data.count == resource.data.count + 1;
      }
      match /heartEvents/{eventId} {
        allow read: if isSignedIn() || get(/databases/$(database)/documents/partyRooms/$(roomId)).data.isActive == true;
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isSignedIn() || get(/databases/$(database)/documents/partyRooms/$(roomId)).data.isActive == true;
        allow create: if isSignedIn()
          && isValidId(roomId)
          && isValidId(messageId)
          && request.resource.data.sender.id == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }

      match /signals/{signalId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      match /voiceParticipants/{userId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (
          request.auth.uid == userId
          || get(/databases/$(database)/documents/partyRooms/$(roomId)).data.host.id == request.auth.uid
          || (
            get(/databases/$(database)/documents/partyRooms/$(roomId)).data.moderatorIds is list
            && request.auth.uid in get(/databases/$(database)/documents/partyRooms/$(roomId)).data.moderatorIds
          )
        );
      }

      match /voiceSignals/{pairId}/messages/{messageId} {
        allow read: if isSignedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
        allow write: if false;
      }
    }

    // Live Streams (Solo Live & PK Battle broadcasts)
    match /liveStreams/{streamId} {
      allow get: if isValidId(streamId) && (isSignedIn() || resource.data.isActive == true);
      allow list: if isSignedIn() || resource.data.isActive == true;
      allow create: if isSignedIn()
        && isValidId(streamId)
        && request.resource.data.host.id == request.auth.uid
        && (!('lastHeartbeat' in request.resource.data) || request.resource.data.lastHeartbeat == request.time);
      allow update: if isSignedIn() && isValidId(streamId) && (
        (resource.data.host.id == request.auth.uid
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastHeartbeat'])
              || request.resource.data.lastHeartbeat == request.time))
        || (resource.data.moderatorIds is list && request.auth.uid in resource.data.moderatorIds
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastHeartbeat', 'lastHeartbeatMs']))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerCount', 'totalGiftCoins', 'updatedAt'])
      );
      allow delete: if isSignedIn() && isValidId(streamId) && resource.data.host.id == request.auth.uid;

      match /stats/{statId} {
        allow read: if isSignedIn() || get(/databases/$(database)/documents/liveStreams/$(streamId)).data.isActive == true;
        allow create: if isSignedIn() && statId == 'hearts' && request.resource.data.count == 1;
        allow update: if isSignedIn() && statId == 'hearts'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt'])
          && request.resource.data.count == resource.data.count + 1;
      }
      match /heartEvents/{eventId} {
        allow read: if isSignedIn() || get(/databases/$(database)/documents/liveStreams/$(streamId)).data.isActive == true;
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isSignedIn() || get(/databases/$(database)/documents/liveStreams/$(streamId)).data.isActive == true;
        allow create: if isSignedIn()
          && isValidId(streamId)
          && isValidId(messageId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }

      match /viewers/{viewerId} {
        allow read: if isSignedIn() || get(/databases/$(database)/documents/liveStreams/$(streamId)).data.isActive == true;
        allow create, update, delete: if isOwner(viewerId);
      }

      match /signals/{signalId} {
        allow read, write: if false;
      }
    }

    // Alpha Mate Reels (Cloudflare R2 + Firestore integration)
    function isValidReel(data) {
      return data.uid is string && data.uid == request.auth.uid
        && data.videoKey is string && data.videoKey.size() <= 256
        && data.videoUrl is string && data.videoUrl.size() <= 1024
        && data.status in ['active', 'archived', 'deleted']
        && data.visibility in ['public', 'private', 'friends']
        && (!('caption' in data) || (data.caption is string && data.caption.size() <= 2000))
        && (!('title' in data) || (data.title is string && data.title.size() <= 256))
        && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 2048));
    }

    match /reels/{reelId} {
      // Public users may read only active and public reels; owners can read their own reels
      allow get: if (resource.data.status == 'active' && resource.data.visibility == 'public')
                 || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if (resource.data.status == 'active' && resource.data.visibility == 'public')
                  || (isSignedIn() && resource.data.uid == request.auth.uid);

      // Only authenticated users may create reels, document UID must match auth.uid
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isValidReel(request.resource.data);

      // Users may update only their own reel metadata without modifying protected fields (uid, videoKey)
      // Viewers can update interaction counters (likesCount, viewsCount)
      allow update: if isSignedIn() && (
        (resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.videoKey == resource.data.videoKey
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'caption', 'thumbnailUrl', 'title', 'tags', 'visibility', 'status',
            'updatedAt', 'likesCount', 'commentsCount', 'viewsCount'
          ]))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'viewsCount']))
      );

      // Only owner may delete a reel
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Reels Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
        allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      }
    }
  }
}

