rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }


    // Alpha Mate private and group chat
    function chatMember(chatId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds && (!('memberStatus' in get(/databases/$(database)/documents/chats/$(chatId)).data) || get(/databases/$(database)/documents/chats/$(chatId)).data.memberStatus[request.auth.uid] == 'joined');
    }
    match /chatRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.status == 'pending';
      allow get, list: if isSignedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','chatId','updatedAt'])
        && request.resource.data.status in ['accepted','rejected','blocked'];
      allow delete: if false;
    }
    match /chats/{chatId} {
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() >= 2
        && request.resource.data.participantIds.size() <= 101;
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow update: if isSignedIn() && request.resource.data.participantIds == resource.data.participantIds
        && ((request.auth.uid in resource.data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastSenderId','updatedAt','unreadBy','memberStatus']))
          || (resource.data.memberStatus[request.auth.uid] == 'invited'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberStatus','updatedAt'])
            && request.resource.data.memberStatus[request.auth.uid] in ['joined','declined']));
      allow delete: if false;
      match /messages/{messageId} {
        allow get, list: if chatMember(chatId);
        allow create: if chatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000;
        allow update: if chatMember(chatId)
          && (resource.data.senderId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy','deliveredTo','deletedFor']));
        allow delete: if false;
      }
    }
    match /groupInvites/{inviteId} {
      allow create: if isSignedIn() && request.resource.data.inviterId == request.auth.uid;
      allow get, list: if isSignedIn() && (resource.data.inviteeId == request.auth.uid || resource.data.inviterId == request.auth.uid);
      allow update: if isSignedIn() && resource.data.inviteeId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
        && request.resource.data.status in ['accepted','declined'];
      allow delete: if false;
    }
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    match /users/{userId}/blockedUsers/{blockedId} {
      allow read, write: if isOwner(userId);
    }

    // Party rooms
    match /partyRooms/{roomId} {
      allow get: if isValidId(roomId) && (isSignedIn() || resource.data.isActive == true);
      allow list: if isSignedIn() || resource.data.isActive == true;
      allow create: if isSignedIn() && isValidId(roomId) && request.resource.data.host.id == request.auth.uid;
      allow update: if isSignedIn() && isValidId(roomId) && (
        resource.data.host.id == request.auth.uid
        || (resource.data.moderatorIds is list && request.auth.uid in resource.data.moderatorIds)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats', 'updatedAt', 'activeViewers', 'totalGiftCoins', 'lastSeenAtMs'])
      );
      allow delete: if isSignedIn() && isValidId(roomId) && resource.data.host.id == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isSignedIn() || get(/databases/$(database)/documents/partyRooms/$(roomId)).data.isActive == true;
        allow create: if isSignedIn()
          && isValidId(roomId)
          && isValidId(messageId)
          && request.resource.data.sender.id == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }

      match /signals/{signalId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      match /voiceParticipants/{userId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (
          request.auth.uid == userId
          || get(/databases/$(database)/documents/partyRooms/$(roomId)).data.host.id == request.auth.uid
          || (
            get(/databases/$(database)/documents/partyRooms/$(roomId)).data.moderatorIds is list
            && request.auth.uid in get(/databases/$(database)/documents/partyRooms/$(roomId)).data.moderatorIds
          )
        );
      }

      match /voiceSignals/{pairId}/messages/{messageId} {
        allow read: if isSignedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
        allow write: if false;
      }
    }

    // Live Streams (Solo Live & PK Battle broadcasts)
    match /liveStreams/{streamId} {
      allow get: if isValidId(streamId) && (isSignedIn() || resource.data.isActive == true);
      allow list: if isSignedIn() || resource.data.isActive == true;
      allow create: if isSignedIn() && isValidId(streamId) && request.resource.data.host.id == request.auth.uid;
      allow update: if isSignedIn() && isValidId(streamId) && (
        resource.data.host.id == request.auth.uid
        || (resource.data.moderatorIds is list && request.auth.uid in resource.data.moderatorIds)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerCount', 'totalGiftCoins', 'updatedAt'])
      );
      allow delete: if isSignedIn() && isValidId(streamId) && resource.data.host.id == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isSignedIn() || get(/databases/$(database)/documents/liveStreams/$(streamId)).data.isActive == true;
        allow create: if isSignedIn()
          && isValidId(streamId)
          && isValidId(messageId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }

      match /signals/{signalId} {
        allow read, write: if false;
      }
    }

    // Alpha Mate Reels (Cloudflare R2 + Firestore integration)
    function isValidReel(data) {
      return data.uid is string && data.uid == request.auth.uid
        && data.videoKey is string && data.videoKey.size() <= 256
        && data.videoUrl is string && data.videoUrl.size() <= 1024
        && data.status in ['active', 'archived', 'deleted']
        && data.visibility in ['public', 'private', 'friends']
        && (!('caption' in data) || (data.caption is string && data.caption.size() <= 2000))
        && (!('title' in data) || (data.title is string && data.title.size() <= 256))
        && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 2048));
    }

    match /reels/{reelId} {
      // Public users may read only active and public reels; owners can read their own reels
      allow get: if (resource.data.status == 'active' && resource.data.visibility == 'public')
                 || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if (resource.data.status == 'active' && resource.data.visibility == 'public')
                  || (isSignedIn() && resource.data.uid == request.auth.uid);

      // Only authenticated users may create reels, document UID must match auth.uid
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isValidReel(request.resource.data);

      // Users may update only their own reel metadata without modifying protected fields (uid, videoKey)
      // Viewers can update interaction counters (likesCount, viewsCount)
      allow update: if isSignedIn() && (
        (resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.videoKey == resource.data.videoKey
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'caption', 'thumbnailUrl', 'title', 'tags', 'visibility', 'status',
            'updatedAt', 'likesCount', 'commentsCount', 'viewsCount'
          ]))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'viewsCount']))
      );

      // Only owner may delete a reel
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Reels Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
        allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      }
    }
  }
}

