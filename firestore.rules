rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isNonEmptyString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidMonthKey(monthKey) {
      return monthKey is string && monthKey.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOfficialAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'alphamateapp@gmail.com';
    }

    function adminProtectedUserFields() {
      return [
        'isBlocked', 'blocked', 'isBanned', 'banned', 'blockReason', 'banReason',
        'blockedAt', 'blockedAtMs', 'blockedBy', 'blockedByName', 'blockMessage',
        'isSuspended', 'suspended', 'suspensionReason', 'suspendReason',
        'suspensionDuration', 'suspensionHours', 'suspensionDays',
        'suspendedAt', 'suspendedAtMs', 'suspensionStartAt',
        'suspendedUntil', 'suspensionExpiresAt', 'suspensionExpiry',
        'isPermanentSuspension', 'permanentSuspension', 'suspensionMessage', 'suspendedBy',
        'liveDisabled', 'liveSuspended', 'liveRestricted', 'liveBanned',
        'liveAccess', 'canGoLive', 'liveRestrictionReason', 'liveSuspensionReason',
        'liveRestrictionDuration', 'liveSuspendedAt', 'liveSuspendedUntil',
        'liveExpiresAt', 'liveRestrictionMessage', 'liveRestrictedBy',
        'partyDisabled', 'partySuspended', 'partyRestricted', 'partyBanned',
        'partyAccess', 'canJoinParty', 'canCreateParty', 'partyRestrictionReason',
        'partySuspensionReason', 'partyRestrictionDuration', 'partyRestrictedAt',
        'partySuspendedUntil', 'partyExpiresAt', 'partyRestrictionMessage', 'partyRestrictedBy',
        'moderation', 'restrictions', 'warnings', 'latestWarning', 'activeWarning',
        'lastAdminAction', 'adminActions',
        'isVerified', 'blueTick', 'hasBlueTick', 'verificationStatus',
        'deviceId', 'deviceFingerprint', 'deviceModel', 'deviceBrand', 'androidVersion', 'appVersion', 'platform', 'ipAddress', 'lastIp', 'lastSeenAt', 'lastSeenAtMs', 'lastLoginAt', 'lastKnownLocation',
        'verificationReason', 'verificationUpdatedAt', 'verificationUpdatedBy',
        'verifiedBy', 'verifiedAt',
        'agencyId', 'hostAgencyId', 'agencyName', 'hostAgencyName',
        'agencyCode', 'hostAgencyCode', 'agencyTag', 'hostAgencyTag',
        'hostAgencyStatus', 'isAgencyHost', 'agencyOwnerId', 'agencyOwnerName',
        'agencyJoinedAt'
      ];
    }

    function adminProtectedUserFieldsExceptIsVerified() {
      return [
        'isBlocked', 'blocked', 'isBanned', 'banned', 'blockReason', 'banReason',
        'blockedAt', 'blockedAtMs', 'blockedBy', 'blockedByName', 'blockMessage',
        'isSuspended', 'suspended', 'suspensionReason', 'suspendReason',
        'suspensionDuration', 'suspensionHours', 'suspensionDays',
        'suspendedAt', 'suspendedAtMs', 'suspensionStartAt',
        'suspendedUntil', 'suspensionExpiresAt', 'suspensionExpiry',
        'isPermanentSuspension', 'permanentSuspension', 'suspensionMessage', 'suspendedBy',
        'liveDisabled', 'liveSuspended', 'liveRestricted', 'liveBanned',
        'liveAccess', 'canGoLive', 'liveRestrictionReason', 'liveSuspensionReason',
        'liveRestrictionDuration', 'liveSuspendedAt', 'liveSuspendedUntil',
        'liveExpiresAt', 'liveRestrictionMessage', 'liveRestrictedBy',
        'partyDisabled', 'partySuspended', 'partyRestricted', 'partyBanned',
        'partyAccess', 'canJoinParty', 'canCreateParty', 'partyRestrictionReason',
        'partySuspensionReason', 'partyRestrictionDuration', 'partyRestrictedAt',
        'partySuspendedUntil', 'partyExpiresAt', 'partyRestrictionMessage', 'partyRestrictedBy',
        'moderation', 'restrictions', 'warnings', 'latestWarning', 'activeWarning',
        'lastAdminAction', 'adminActions',
        'blueTick', 'hasBlueTick', 'verificationStatus',
        'deviceId', 'deviceFingerprint', 'deviceModel', 'deviceBrand', 'androidVersion', 'appVersion', 'platform', 'ipAddress', 'lastIp', 'lastSeenAt', 'lastSeenAtMs', 'lastLoginAt', 'lastKnownLocation',
        'verificationReason', 'verificationUpdatedAt', 'verificationUpdatedBy',
        'verifiedBy', 'verifiedAt',
        'agencyId', 'hostAgencyId', 'agencyName', 'hostAgencyName',
        'agencyCode', 'hostAgencyCode', 'agencyTag', 'hostAgencyTag',
        'hostAgencyStatus', 'isAgencyHost', 'agencyOwnerId', 'agencyOwnerName',
        'agencyJoinedAt'
      ];
    }

    function isClientAllowedUserCreate(data) {
      return !data.keys().hasAny(adminProtectedUserFieldsExceptIsVerified())
        && (!('isVerified' in data) || data.isVerified == false)
        && (!('accountStatus' in data) || data.accountStatus in ['active', 'deactivated', 'pending_deletion']);
    }

    function isClientAllowedUserUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(adminProtectedUserFields())
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountStatus'])
          || (
            (!('accountStatus' in resource.data) || !(resource.data.accountStatus in ['blocked', 'banned', 'suspended']))
            && request.resource.data.accountStatus in ['active', 'deactivated', 'pending_deletion']
          )
        );
    }

    function isUserDocHardBlocked(userData) {
      return userData != null && (
        ('isBlocked' in userData && userData.isBlocked == true)
        || ('blocked' in userData && userData.blocked == true)
        || ('isBanned' in userData && userData.isBanned == true)
        || ('banned' in userData && userData.banned == true)
        || ('accountStatus' in userData && userData.accountStatus in ['blocked', 'banned'])
        || ('isPermanentSuspension' in userData && userData.isPermanentSuspension == true)
        || ('permanentSuspension' in userData && userData.permanentSuspension == true)
      );
    }

    function isCurrentUserAllowedForLive() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || (
          !isUserDocHardBlocked(get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          && !(
            'liveDisabled' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.liveDisabled == true
            && !('liveExpiresAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
            && !('liveSuspendedUntil' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          )
        );
    }

    function isCurrentUserAllowedForParty() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || (
          !isUserDocHardBlocked(get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          && !(
            'partyDisabled' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.partyDisabled == true
            && !('partyExpiresAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
            && !('partySuspendedUntil' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          )
        );
    }

    function isValidAccountDeletionRequest(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'type', 'status', 'requestedAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'uniqueId', 'username', 'displayName', 'email', 'avatar',
          'type', 'status', 'otpVerified', 'otpVerifiedAt', 'requestedAt',
          'scheduledPermanentDeletionAt', 'reason', 'recoveredAt', 'permanentlyDeletedAt',
          'processedBy', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 128
        && data.displayName is string && data.displayName.size() <= 128
        && data.type in ['deactivation', 'permanent_delete']
        && data.status in ['deactivated', 'pending_official_deletion', 'recovered', 'permanently_deleted']
        && data.requestedAt is string && data.requestedAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('otpVerified' in data) || data.otpVerified is bool)
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 500));
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['recipientId', 'senderId', 'type', 'title', 'message', 'isRead', 'createdAt', 'createdAtMs'])
        && data.keys().hasOnly([
          'recipientId', 'senderId', 'senderName', 'senderAvatar', 'type', 'category',
          'title', 'message', 'screen', 'tab', 'roomId', 'streamId', 'reelId', 'chatId',
          'isRead', 'readAt', 'createdAt', 'createdAtMs'
        ])
        && data.recipientId is string && data.recipientId.size() > 0 && data.recipientId.size() <= 128
        && data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128
        && data.type in [
          'live_on', 'live_invite', 'party_invite', 'friend_request', 'follow', 'gift',
          'comment', 'message', 'like', 'pk_invite', 'wallet', 'agency', 'system'
        ]
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.message is string && data.message.size() > 0 && data.message.size() <= 600
        && (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 128))
        && (!('senderAvatar' in data) || (data.senderAvatar is string && data.senderAvatar.size() <= 65000))
        && (!('category' in data) || (data.category is string && data.category.size() <= 64))
        && (!('screen' in data) || (data.screen is string && data.screen.size() <= 64))
        && (!('tab' in data) || (data.tab is string && data.tab.size() <= 64))
        && (!('roomId' in data) || (data.roomId is string && data.roomId.size() <= 128))
        && (!('streamId' in data) || (data.streamId is string && data.streamId.size() <= 128))
        && (!('reelId' in data) || (data.reelId is string && data.reelId.size() <= 128))
        && (!('chatId' in data) || (data.chatId is string && data.chatId.size() <= 128))
        && (!('readAt' in data) || (data.readAt is string && data.readAt.size() <= 64))
        && data.isRead is bool
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.createdAtMs is number;
    }

    function isValidGiftTransaction(data) {
      return data.keys().hasAll([
          'senderId', 'recipientId', 'giftId', 'giftName', 'quantity',
          'totalCoins', 'hostDiamonds', 'appShareCoins', 'context', 'status',
          'createdAt', 'createdAtMs'
        ])
        && data.keys().hasOnly([
          'senderId', 'senderName', 'recipientId', 'recipientName', 'giftId', 'giftName', 'giftIcon',
          'quantity', 'totalCoins', 'hostDiamonds', 'appShareCoins', 'context',
          'roomId', 'streamId', 'reelId', 'status', 'createdAt', 'createdAtMs'
        ])
        && data.senderId == request.auth.uid
        && data.recipientId is string && data.recipientId.size() > 0 && data.recipientId.size() <= 128
        && data.giftId is string && data.giftId.size() > 0 && data.giftId.size() <= 64
        && data.giftName is string && data.giftName.size() > 0 && data.giftName.size() <= 80
        && data.quantity is number && data.quantity >= 1 && data.quantity <= 9999
        && data.totalCoins is number && data.totalCoins > 0 && data.totalCoins <= 50000000
        && data.hostDiamonds is number && data.hostDiamonds >= 0
        && data.appShareCoins is number && data.appShareCoins >= 0
        && (data.hostDiamonds + data.appShareCoins) == data.totalCoins
        && data.context in ['live', 'party', 'moments', 'pk', 'demo']
        && data.status == 'completed'
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.createdAtMs is number;
    }

    function isValidLeaderboardEntry(data, userId, monthKey) {
      return data.keys().hasAll([
          'uid', 'displayName', 'monthKey', 'weekKey',
          'receivedGiftCoins', 'receivedDiamonds', 'giftsCount', 'timeSpentMinutes', 'score',
          'weeklyGiftCoins', 'weeklyDiamonds', 'weeklyGiftsCount', 'weeklyTimeSpentMinutes', 'weeklyScore',
          'updatedAt', 'updatedAtMs'
        ])
        && data.keys().hasOnly([
          'uid', 'uniqueId', 'displayName', 'username', 'avatar', 'countryFlag',
          'level', 'vipTier', 'monthKey', 'weekKey',
          'receivedGiftCoins', 'receivedDiamonds', 'giftsCount', 'timeSpentMinutes', 'score',
          'weeklyGiftCoins', 'weeklyDiamonds', 'weeklyGiftsCount', 'weeklyTimeSpentMinutes', 'weeklyScore',
          'isLive', 'isRealUser', 'equippedBadgeIds', 'updatedAt', 'updatedAtMs'
        ])
        && (!('equippedBadgeIds' in data) || (data.equippedBadgeIds is list && data.equippedBadgeIds.size() <= 8))
        && data.uid == userId
        && data.monthKey == monthKey
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 128
        && data.weekKey is string && data.weekKey.size() >= 6 && data.weekKey.size() <= 16
        && data.receivedGiftCoins is number && data.receivedGiftCoins >= 0 && data.receivedGiftCoins <= 1000000000
        && data.receivedDiamonds is number && data.receivedDiamonds >= 0 && data.receivedDiamonds <= 1000000000
        && data.giftsCount is number && data.giftsCount >= 0 && data.giftsCount <= 10000000
        && data.timeSpentMinutes is number && data.timeSpentMinutes >= 0 && data.timeSpentMinutes <= 50000
        && data.score is number && data.score >= 0
        && data.weeklyGiftCoins is number && data.weeklyGiftCoins >= 0 && data.weeklyGiftCoins <= 1000000000
        && data.weeklyDiamonds is number && data.weeklyDiamonds >= 0 && data.weeklyDiamonds <= 1000000000
        && data.weeklyGiftsCount is number && data.weeklyGiftsCount >= 0 && data.weeklyGiftsCount <= 10000000
        && data.weeklyTimeSpentMinutes is number && data.weeklyTimeSpentMinutes >= 0 && data.weeklyTimeSpentMinutes <= 11000
        && data.weeklyScore is number && data.weeklyScore >= 0
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.updatedAtMs is number;
    }

    function isValidBadgeStats(data, userId) {
      return data.keys().hasAll([
          'uid', 'totalGiftCoinsSent', 'totalGiftsSentCount', 'totalGiftCoinsReceived',
          'totalDiamondsEarned', 'totalActiveMinutes', 'partyRoomMinutes', 'liveStreamMinutes',
          'longestPartySessionMinutes', 'checkInDaysCount', 'maxDailyStreak',
          'postsCreatedCount', 'equippedBadgeIds', 'earnedBadges', 'updatedAt', 'updatedAtMs'
        ])
        && data.keys().hasOnly([
          'uid', 'totalGiftCoinsSent', 'totalGiftsSentCount', 'totalGiftCoinsReceived',
          'totalDiamondsEarned', 'totalActiveMinutes', 'partyRoomMinutes', 'liveStreamMinutes',
          'longestPartySessionMinutes', 'bestLeaderboardRank', 'checkInDaysCount', 'maxDailyStreak',
          'postsCreatedCount', 'equippedBadgeIds', 'earnedBadges', 'updatedAt', 'updatedAtMs'
        ])
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.totalGiftCoinsSent is number && data.totalGiftCoinsSent >= 0 && data.totalGiftCoinsSent <= 2000000000
        && data.totalGiftsSentCount is number && data.totalGiftsSentCount >= 0 && data.totalGiftsSentCount <= 10000000
        && data.totalGiftCoinsReceived is number && data.totalGiftCoinsReceived >= 0 && data.totalGiftCoinsReceived <= 2000000000
        && data.totalDiamondsEarned is number && data.totalDiamondsEarned >= 0 && data.totalDiamondsEarned <= 2000000000
        && data.totalActiveMinutes is number && data.totalActiveMinutes >= 0 && data.totalActiveMinutes <= 5000000
        && data.partyRoomMinutes is number && data.partyRoomMinutes >= 0 && data.partyRoomMinutes <= 5000000
        && data.liveStreamMinutes is number && data.liveStreamMinutes >= 0 && data.liveStreamMinutes <= 5000000
        && data.longestPartySessionMinutes is number && data.longestPartySessionMinutes >= 0 && data.longestPartySessionMinutes <= 100000
        && (!('bestLeaderboardRank' in data) || data.bestLeaderboardRank == null || (data.bestLeaderboardRank is number && data.bestLeaderboardRank >= 1 && data.bestLeaderboardRank <= 100000))
        && data.checkInDaysCount is number && data.checkInDaysCount >= 0 && data.checkInDaysCount <= 100000
        && data.maxDailyStreak is number && data.maxDailyStreak >= 0 && data.maxDailyStreak <= 10000
        && data.postsCreatedCount is number && data.postsCreatedCount >= 0 && data.postsCreatedCount <= 1000000
        && data.equippedBadgeIds is list && data.equippedBadgeIds.size() <= 8
        && (data.equippedBadgeIds.size() == 0 || data.equippedBadgeIds[0] is string)
        && data.earnedBadges is map
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.updatedAtMs is number;
    }

    // Connection testing
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // Server-only Email OTP Challenges & Multi-Account Device Switch Sessions
    match /emailOtpChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /deviceSwitchSessions/{sessionId} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(userId) && (
        isOfficialAdmin()
        || (isOwner(userId) && isClientAllowedUserCreate(request.resource.data))
      );
      allow update: if isOfficialAdmin()
        || (isOwner(userId) && isValidId(userId) && isClientAllowedUserUpdate())
        || (
          isSignedIn()
          && isValidId(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['diamonds', 'updatedAt'])
          && request.resource.data.diamonds is number
          && (!('diamonds' in resource.data) || resource.data.diamonds is number)
          && request.resource.data.diamonds > (('diamonds' in resource.data) ? resource.data.diamonds : 0)
          && request.resource.data.diamonds <= (('diamonds' in resource.data) ? resource.data.diamonds : 0) + 5000000
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 64
        );
      allow delete: if false;

      // Per-user real-time notifications inbox (includes Official Admin Action notifications)
      match /notifications/{notificationId} {
        allow get: if isValidId(userId) && isValidId(notificationId) && (isOwner(userId) || isOfficialAdmin());
        allow list: if isOwner(userId) || isOfficialAdmin();
        allow create: if isSignedIn()
          && isValidId(userId)
          && isValidId(notificationId)
          && (
            isOfficialAdmin()
            || (
              request.resource.data.senderId == request.auth.uid
              && request.resource.data.recipientId == userId
              && isValidNotification(request.resource.data)
            )
          );
        allow update: if isValidId(userId)
          && isValidId(notificationId)
          && (
            isOfficialAdmin()
            || (
              isOwner(userId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'acknowledged', 'acknowledgedAt'])
              && (!('isRead' in request.resource.data) || request.resource.data.isRead is bool)
              && (!('readAt' in request.resource.data) || (request.resource.data.readAt is string && request.resource.data.readAt.size() <= 64))
              && (!('acknowledged' in request.resource.data) || request.resource.data.acknowledged is bool)
              && (!('acknowledgedAt' in request.resource.data) || (request.resource.data.acknowledgedAt is string && request.resource.data.acknowledgedAt.size() <= 64))
            )
          );
        allow delete: if isValidId(userId)
          && isValidId(notificationId)
          && (
            isOfficialAdmin()
            || (
              isOwner(userId)
              && !('isAdminAction' in resource.data && resource.data.isAdminAction == true)
              && !(resource.data.type in [
                'admin_action', 'admin_warning', 'moderation', 'verification',
                'account_blocked', 'account_suspended', 'live_restricted',
                'party_restricted', 'access_restored'
              ])
            )
          );
      }

      // Per-user Official Admin Actions log (read & mark read by affected user; write only by Official Admin)
      match /adminActions/{actionId} {
        allow get: if isValidId(userId) && isValidId(actionId) && (isOwner(userId) || isOfficialAdmin());
        allow list: if isOwner(userId) || isOfficialAdmin();
        allow create, delete: if isValidId(userId) && isValidId(actionId) && isOfficialAdmin();
        allow update: if isValidId(userId)
          && isValidId(actionId)
          && (
            isOfficialAdmin()
            || (
              isOwner(userId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'acknowledged', 'acknowledgedAt'])
              && (!('isRead' in request.resource.data) || request.resource.data.isRead is bool)
              && (!('readAt' in request.resource.data) || (request.resource.data.readAt is string && request.resource.data.readAt.size() <= 64))
              && (!('acknowledged' in request.resource.data) || request.resource.data.acknowledged is bool)
              && (!('acknowledgedAt' in request.resource.data) || (request.resource.data.acknowledgedAt is string && request.resource.data.acknowledgedAt.size() <= 64))
            )
          );
      }

      // Per-user Official Admin Warnings history (read & mark read by affected user; write only by Official Admin)
      match /warnings/{warningId} {
        allow get: if isValidId(userId) && isValidId(warningId) && (isOwner(userId) || isOfficialAdmin());
        allow list: if isOwner(userId) || isOfficialAdmin();
        allow create, delete: if isValidId(userId) && isValidId(warningId) && isOfficialAdmin();
        allow update: if isValidId(userId)
          && isValidId(warningId)
          && (
            isOfficialAdmin()
            || (
              isOwner(userId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'acknowledged', 'acknowledgedAt'])
              && (!('isRead' in request.resource.data) || request.resource.data.isRead is bool)
              && (!('readAt' in request.resource.data) || (request.resource.data.readAt is string && request.resource.data.readAt.size() <= 64))
              && (!('acknowledged' in request.resource.data) || request.resource.data.acknowledged is bool)
              && (!('acknowledgedAt' in request.resource.data) || (request.resource.data.acknowledgedAt is string && request.resource.data.acknowledgedAt.size() <= 64))
            )
          );
      }

      // Per-user historical achievement counters and earned/equipped User Badges
      match /badgeStats/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isSignedIn();
        allow list: if isOwner(userId);
        allow create: if isValidId(userId)
          && isValidId(docId)
          && isOwner(userId)
          && isValidBadgeStats(request.resource.data, userId);
        allow update: if isValidId(userId)
          && isValidId(docId)
          && isOwner(userId)
          && isValidBadgeStats(request.resource.data, userId)
          && request.resource.data.uid == resource.data.uid;
        allow delete: if false;
      }
    }

    // Top-level Official Admin Moderation Actions log (strict per-UID read isolation; Official Admin write only)
    match /adminActions/{actionId} {
      allow get: if isValidId(actionId) && (
        isOfficialAdmin()
        || (
          isSignedIn()
          && resource != null
          && (resource.data.targetUserId == request.auth.uid || resource.data.userId == request.auth.uid)
        )
      );
      allow list: if isOfficialAdmin()
        || (
          isSignedIn()
          && (resource.data.targetUserId == request.auth.uid || resource.data.userId == request.auth.uid)
        );
      allow create, update, delete: if isValidId(actionId) && isOfficialAdmin();
    }

    function isValidFollowEdge(data, edgeId) {
      return data.keys().hasOnly([
        'followerId', 'targetId', 'followerName', 'followerUsername', 'followerAvatar',
        'targetName', 'targetUsername', 'targetAvatar', 'createdAt', 'createdAtMs'
      ])
      && isNonEmptyString(data.followerId, 1, 128)
      && isNonEmptyString(data.targetId, 1, 128)
      && data.followerId == request.auth.uid
      && data.targetId != request.auth.uid
      && edgeId == (data.followerId + '_' + data.targetId)
      && data.createdAtMs is number;
    }

    // Real-time bidirectional Follow / Follow Back edges
    match /userFollows/{edgeId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(edgeId)
        && isValidFollowEdge(request.resource.data, edgeId);
      allow update: if false;
      allow delete: if isSignedIn()
        && isValidId(edgeId)
        && resource.data.followerId == request.auth.uid;
    }

    // Immutable 60/40 Gifting Ledger (60% Host Diamonds, 40% App Revenue Share)
    match /giftTransactions/{txId} {
      allow get: if isValidId(txId)
        && isSignedIn()
        && (isOfficialAdmin() || resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow list: if isSignedIn()
        && (isOfficialAdmin() || resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if isValidId(txId)
        && isSignedIn()
        && isValidGiftTransaction(request.resource.data);
      allow update, delete: if false;
    }

    // Account Deactivation & 15-Day Official Permanent Deletion Queue
    match /accountDeletionRequests/{requestId} {
      allow get: if isValidId(requestId) && (isOwner(requestId) || isOfficialAdmin());
      allow list: if isSignedIn() && (isOfficialAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isValidId(requestId)
        && isOwner(requestId)
        && request.resource.data.uid == request.auth.uid
        && isValidAccountDeletionRequest(request.resource.data);
      allow update: if isValidId(requestId)
        && isValidAccountDeletionRequest(request.resource.data)
        && (
          (isOwner(requestId) && request.resource.data.uid == resource.data.uid)
          || isOfficialAdmin()
        );
      allow delete: if false;
    }

    function isValidAgencyApplication(data) {
      return data.keys().hasAll([
          'id', 'type', 'applicantUserId', 'applicantName', 'applicantUniqueId',
          'agencyName', 'whatsapp', 'phoneNumber', 'experience', 'status',
          'submittedAt', 'createdAtMs'
        ])
        && data.keys().hasOnly([
          'id', 'type', 'applicantUserId', 'applicantName', 'applicantUniqueId',
          'agencyName', 'agencyTag', 'whatsapp', 'phoneNumber', 'idCardNumber',
          'experience', 'status', 'submittedAt', 'createdAtMs', 'reviewedAt', 'reviewedBy'
        ])
        && isNonEmptyString(data.id, 1, 128)
        && data.type in ['coin_seller', 'host_agency']
        && isNonEmptyString(data.applicantUserId, 1, 128)
        && isNonEmptyString(data.applicantName, 1, 128)
        && isNonEmptyString(data.applicantUniqueId, 1, 64)
        && isNonEmptyString(data.agencyName, 2, 128)
        && (!('agencyTag' in data) || (data.agencyTag is string && data.agencyTag.size() <= 16))
        && isNonEmptyString(data.whatsapp, 3, 64)
        && isNonEmptyString(data.phoneNumber, 3, 64)
        && (!('idCardNumber' in data) || (data.idCardNumber is string && data.idCardNumber.size() <= 64))
        && isNonEmptyString(data.experience, 1, 1000)
        && data.status in ['pending', 'approved', 'rejected']
        && data.submittedAt is string && data.submittedAt.size() <= 64
        && data.createdAtMs is number
        && (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 64))
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128));
    }

    function isValidOfficialAgency(data) {
      return data.keys().hasAll([
          'agencyId', 'type', 'agencyName', 'agencyCode', 'ownerUserId',
          'agencyBalance', 'whatsappNumber', 'whatsappDisplay', 'slogan',
          'isOfficial', 'status', 'createdAt', 'createdAtMs', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'agencyId', 'type', 'agencyName', 'agencyCode', 'agencyTag', 'tagColor',
          'badge', 'logo', 'ownerUserId', 'ownerName', 'ownerUniqueId', 'ownerAvatar',
          'agencyBalance', 'isPinSet', 'whatsappNumber', 'whatsappDisplay',
          'defaultCommissionRate', 'minWeeklyHours', 'slogan', 'isOfficial',
          'activeHostsCount', 'totalHosts', 'paymentMethods', 'rates',
          'status', 'createdAt', 'createdAtMs', 'updatedAt'
        ])
        && isNonEmptyString(data.agencyId, 1, 128)
        && data.type in ['coin_seller', 'host_agency']
        && isNonEmptyString(data.agencyName, 2, 128)
        && isNonEmptyString(data.agencyCode, 2, 64)
        && (!('agencyTag' in data) || (data.agencyTag is string && data.agencyTag.size() <= 16))
        && (!('tagColor' in data) || (data.tagColor is string && data.tagColor.size() <= 32))
        && (!('badge' in data) || (data.badge is string && data.badge.size() <= 80))
        && (!('logo' in data) || (data.logo is string && data.logo.size() <= 2048))
        && isNonEmptyString(data.ownerUserId, 1, 128)
        && (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 128))
        && (!('ownerUniqueId' in data) || (data.ownerUniqueId is string && data.ownerUniqueId.size() <= 64))
        && (!('ownerAvatar' in data) || (data.ownerAvatar is string && data.ownerAvatar.size() <= 2048))
        && data.agencyBalance is number && data.agencyBalance >= 0 && data.agencyBalance <= 1000000000
        && (!('isPinSet' in data) || data.isPinSet is bool)
        && isNonEmptyString(data.whatsappNumber, 3, 64)
        && isNonEmptyString(data.whatsappDisplay, 3, 64)
        && (!('defaultCommissionRate' in data) || (data.defaultCommissionRate is number && data.defaultCommissionRate >= 0 && data.defaultCommissionRate <= 80))
        && (!('minWeeklyHours' in data) || (data.minWeeklyHours is number && data.minWeeklyHours >= 0 && data.minWeeklyHours <= 168))
        && isNonEmptyString(data.slogan, 1, 300)
        && data.isOfficial is bool
        && (!('activeHostsCount' in data) || (data.activeHostsCount is number && data.activeHostsCount >= 0 && data.activeHostsCount <= 100000))
        && (!('totalHosts' in data) || (data.totalHosts is number && data.totalHosts >= 0 && data.totalHosts <= 100000))
        && (!('paymentMethods' in data) || (data.paymentMethods is list && data.paymentMethods.size() <= 12))
        && (!('rates' in data) || (data.rates is list && data.rates.size() <= 12))
        && data.status in ['active', 'Active', 'ACTIVE', 'suspended', 'Suspended', 'hold', 'Hold']
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.createdAtMs is number
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidHostAgencyRequest(data) {
      return data.keys().hasAll([
          'id', 'applicantUid', 'userId', 'userDocId', 'agencyId', 'agencyName',
          'agencyType', 'status', 'createdAt', 'createdAtMs'
        ])
        && data.keys().hasOnly([
          'id', 'applicantUid', 'userId', 'userDocId', 'uniqueId', 'displayName',
          'applicantName', 'username', 'avatar', 'level', 'agencyId', 'agencyName',
          'agencyCode', 'agencyTag', 'agencyOwnerId', 'agencyType', 'requestedAgencyType',
          'whatsapp', 'experience', 'expectedHours', 'status', 'rejectionReason',
          'reviewedAt', 'reviewedBy', 'createdAt', 'appliedAt', 'createdAtMs', 'updatedAt'
        ])
        && isNonEmptyString(data.id, 1, 128)
        && isNonEmptyString(data.applicantUid, 1, 128)
        && isNonEmptyString(data.userId, 1, 128)
        && isNonEmptyString(data.userDocId, 1, 128)
        && (!('uniqueId' in data) || (data.uniqueId is string && data.uniqueId.size() <= 64))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('applicantName' in data) || (data.applicantName is string && data.applicantName.size() <= 128))
        && (!('username' in data) || (data.username is string && data.username.size() <= 64))
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 2048))
        && (!('level' in data) || (data.level is number && data.level >= 0 && data.level <= 200))
        && isNonEmptyString(data.agencyId, 1, 128)
        && isNonEmptyString(data.agencyName, 1, 128)
        && (!('agencyCode' in data) || (data.agencyCode is string && data.agencyCode.size() <= 64))
        && (!('agencyTag' in data) || (data.agencyTag is string && data.agencyTag.size() <= 16))
        && (!('agencyOwnerId' in data) || (data.agencyOwnerId is string && data.agencyOwnerId.size() <= 128))
        && data.agencyType == 'Host Agency'
        && (!('requestedAgencyType' in data) || data.requestedAgencyType == 'Host Agency')
        && (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 64))
        && (!('experience' in data) || (data.experience is string && data.experience.size() <= 1000))
        && (!('expectedHours' in data) || (data.expectedHours is number && data.expectedHours >= 0 && data.expectedHours <= 168))
        && data.status in ['Pending', 'Approved', 'Rejected', 'pending', 'approved', 'rejected']
        && (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 500))
        && (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 64))
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128))
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('appliedAt' in data) || (data.appliedAt is string && data.appliedAt.size() <= 64))
        && data.createdAtMs is number
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Coin Seller & Host Agency License Applications (Never auto-approved client-side)
    match /agencyApplications/{applicationId} {
      allow get: if isValidId(applicationId)
        && isSignedIn()
        && (isOfficialAdmin() || (resource != null && resource.data.applicantUserId == request.auth.uid));
      allow list: if isSignedIn()
        && (isOfficialAdmin() || resource.data.applicantUserId == request.auth.uid);
      allow create: if isValidId(applicationId)
        && isSignedIn()
        && isValidAgencyApplication(request.resource.data)
        && request.resource.data.id == applicationId
        && request.resource.data.applicantUserId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isValidId(applicationId)
        && isOfficialAdmin()
        && isValidAgencyApplication(request.resource.data)
        && request.resource.data.applicantUserId == resource.data.applicantUserId
        && request.resource.data.type == resource.data.type
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if false;
    }

    // Official Admin-Approved Agencies (Active Coin Seller & Host Agencies readable in real time; Hold/Suspended restricted)
    match /agencies/{agencyId} {
      allow get: if isValidId(agencyId)
        && isSignedIn()
        && (
          resource == null
          || resource.data.status in ['active', 'Active', 'ACTIVE']
          || resource.data.ownerUserId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
          || resource.data.ownerUid == request.auth.uid
          || isOfficialAdmin()
        );
      allow list: if isSignedIn()
        && (
          resource.data.status in ['active', 'Active', 'ACTIVE']
          || resource.data.ownerUserId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
          || resource.data.ownerUid == request.auth.uid
          || isOfficialAdmin()
        );
      allow create: if isValidId(agencyId)
        && isOfficialAdmin()
        && isValidOfficialAgency(request.resource.data)
        && request.resource.data.agencyId == agencyId
        && request.resource.data.agencyBalance == 0;
      allow update: if isValidId(agencyId)
        && isSignedIn()
        && isValidOfficialAgency(request.resource.data)
        && request.resource.data.agencyId == resource.data.agencyId
        && request.resource.data.type == resource.data.type
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && (
          isOfficialAdmin()
          || (
            resource.data.ownerUserId == request.auth.uid
            && request.resource.data.status == resource.data.status
            && request.resource.data.isOfficial == resource.data.isOfficial
            && (
              request.resource.data.agencyBalance == resource.data.agencyBalance
              || (
                resource.data.type == 'coin_seller'
                && request.resource.data.agencyBalance >= 0
                && request.resource.data.agencyBalance < resource.data.agencyBalance
              )
            )
          )
        );
      allow delete: if false;
    }

    // Shared Host Agency Join Requests (Submitted strictly as Pending; membership activated only by Super Admin approval)
    match /agency_requests/{requestId} {
      allow get: if isValidId(requestId)
        && isSignedIn()
        && (
          isOfficialAdmin()
          || (
            resource != null
            && (
              resource.data.applicantUid == request.auth.uid
              || resource.data.userId == request.auth.uid
              || resource.data.agencyOwnerId == request.auth.uid
            )
          )
        );
      allow list: if isSignedIn()
        && (
          isOfficialAdmin()
          || resource.data.applicantUid == request.auth.uid
          || resource.data.userId == request.auth.uid
          || resource.data.agencyOwnerId == request.auth.uid
        );
      allow create: if isValidId(requestId)
        && isSignedIn()
        && isValidHostAgencyRequest(request.resource.data)
        && request.resource.data.id == requestId
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userDocId == request.auth.uid
        && request.resource.data.status == 'Pending';
      allow update: if isValidId(requestId)
        && isSignedIn()
        && (isOfficialAdmin() || resource.data.agencyOwnerId == request.auth.uid)
        && isValidHostAgencyRequest(request.resource.data)
        && request.resource.data.applicantUid == resource.data.applicantUid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.agencyId == resource.data.agencyId
        && request.resource.data.agencyType == resource.data.agencyType
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'rejectionReason', 'reviewedAt', 'reviewedBy', 'updatedAt'
        ])
        && request.resource.data.status in ['Approved', 'Rejected', 'approved', 'rejected'];
      allow delete: if false;
    }

    // Monthly-refreshing Global & Weekly Leaderboard (public non-PII stats per monthKey)
    match /leaderboardMonths/{monthKey}/entries/{userId} {
      allow get, list: if isSignedIn() && isValidMonthKey(monthKey);
      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidMonthKey(monthKey)
        && isValidLeaderboardEntry(request.resource.data, userId, monthKey)
        && (
          isOwner(userId)
          || isOfficialAdmin()
          || (request.resource.data.receivedGiftCoins > 0 && request.resource.data.timeSpentMinutes == 0)
        );
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidMonthKey(monthKey)
        && isValidLeaderboardEntry(request.resource.data, userId, monthKey)
        && (
          isOwner(userId)
          || isOfficialAdmin()
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'receivedGiftCoins', 'receivedDiamonds', 'giftsCount', 'score',
              'weeklyGiftCoins', 'weeklyDiamonds', 'weeklyGiftsCount', 'weeklyScore',
              'weekKey', 'displayName', 'avatar', 'updatedAt', 'updatedAtMs'
            ])
            && request.resource.data.receivedGiftCoins >= resource.data.receivedGiftCoins
            && request.resource.data.receivedDiamonds >= resource.data.receivedDiamonds
            && request.resource.data.giftsCount >= resource.data.giftsCount
          )
        );
      allow delete: if isOfficialAdmin();
    }


    // Alpha Mate private and group chat
    function isParticipantInChatData(chatData) {
      return chatData != null
        && ('participantIds' in chatData)
        && request.auth.uid in chatData.participantIds
        && (!('memberStatus' in chatData) || chatData.memberStatus[request.auth.uid] == 'joined');
    }

    function chatMember(chatId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && isParticipantInChatData(get(/databases/$(database)/documents/chats/$(chatId)).data);
    }

    function chatMemberAfter(chatId) {
      return isSignedIn()
        && existsAfter(/databases/$(database)/documents/chats/$(chatId))
        && isParticipantInChatData(getAfter(/databases/$(database)/documents/chats/$(chatId)).data);
    }

    function isValidChatRequestPayload(data) {
      return data.keys().hasAll(['senderId', 'recipientId', 'firstMessage', 'status'])
        && data.keys().hasOnly([
          'senderId', 'recipientId', 'sender', 'recipient',
          'firstMessage', 'lastMessage', 'pendingMessages',
          'status', 'chatId', 'createdAt', 'createdAtMs', 'updatedAt', 'updatedAtMs'
        ])
        && data.senderId == request.auth.uid
        && isNonEmptyString(data.recipientId, 1, 128)
        && data.recipientId != request.auth.uid
        && isNonEmptyString(data.firstMessage, 1, 4000)
        && (!('lastMessage' in data) || isNonEmptyString(data.lastMessage, 1, 4000))
        && (!('pendingMessages' in data) || (data.pendingMessages is list && data.pendingMessages.size() <= 20))
        && (!('sender' in data) || data.sender is map)
        && (!('recipient' in data) || data.recipient is map)
        && data.status == 'pending';
    }

    match /chatRequests/{requestId} {
      allow get: if isSignedIn()
        && isValidId(requestId)
        && (resource == null || resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(requestId)
        && isValidChatRequestPayload(request.resource.data);
      allow update: if isSignedIn()
        && isValidId(requestId)
        && (
          // Action 1: Sender sends additional message(s) while pending or re-sends after previous request (unless blocked)
          (resource.data.senderId == request.auth.uid
            && resource.data.status != 'blocked'
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.recipientId == resource.data.recipientId
            && isValidChatRequestPayload(request.resource.data))
          ||
          // Action 2: Recipient approves, rejects, or blocks the chat request
          (resource.data.recipientId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'chatId', 'updatedAt', 'updatedAtMs'])
            && request.resource.data.status in ['accepted', 'rejected', 'blocked']
            && (!('chatId' in request.resource.data) || isNonEmptyString(request.resource.data.chatId, 1, 128)))
        );
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow create: if isSignedIn()
        && isValidId(chatId)
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() >= 2
        && request.resource.data.participantIds.size() <= 101
        && request.auth.uid in request.resource.data.participantIds;
      allow get: if isSignedIn()
        && isValidId(chatId)
        && (resource == null || request.auth.uid in resource.data.participantIds);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow update: if isSignedIn()
        && isValidId(chatId)
        && request.resource.data.participantIds == resource.data.participantIds
        && (
          (request.auth.uid in resource.data.participantIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessage', 'lastSenderId', 'updatedAt', 'updatedAtMs', 'unreadBy', 'memberStatus', 'participantProfiles'
            ]))
          || (resource.data.memberStatus[request.auth.uid] == 'invited'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberStatus', 'updatedAt', 'updatedAtMs'])
            && request.resource.data.memberStatus[request.auth.uid] in ['joined', 'declined'])
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isValidId(messageId) && chatMember(chatId);
        allow list: if chatMember(chatId);
        allow create: if isValidId(messageId)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && (
            // Standard message sent by an active member of the chat
            (chatMember(chatId) && request.resource.data.senderId == request.auth.uid)
            ||
            // Initial request message(s) migrated atomically when recipient approves a pending chatRequest
            (chatMemberAfter(chatId)
              && ('fromAcceptedRequestId' in request.resource.data)
              && isValidId(request.resource.data.fromAcceptedRequestId)
              && exists(/databases/$(database)/documents/chatRequests/$(request.resource.data.fromAcceptedRequestId))
              && get(/databases/$(database)/documents/chatRequests/$(request.resource.data.fromAcceptedRequestId)).data.recipientId == request.auth.uid
              && get(/databases/$(database)/documents/chatRequests/$(request.resource.data.fromAcceptedRequestId)).data.status == 'pending'
              && getAfter(/databases/$(database)/documents/chatRequests/$(request.resource.data.fromAcceptedRequestId)).data.status == 'accepted'
              && request.resource.data.senderId == get(/databases/$(database)/documents/chatRequests/$(request.resource.data.fromAcceptedRequestId)).data.senderId)
          );
        allow update: if isValidId(messageId)
          && chatMember(chatId)
          && (
            (resource.data.senderId == request.auth.uid
              && request.resource.data.senderId == resource.data.senderId)
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'deliveredTo', 'deletedFor'])
          );
        allow delete: if false;
      }
    }

    match /groupInvites/{inviteId} {
      allow create: if isSignedIn() && isValidId(inviteId) && request.resource.data.inviterId == request.auth.uid;
      allow get: if isSignedIn()
        && isValidId(inviteId)
        && (resource == null || resource.data.inviteeId == request.auth.uid || resource.data.inviterId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.inviteeId == request.auth.uid || resource.data.inviterId == request.auth.uid);
      allow update: if isSignedIn()
        && isValidId(inviteId)
        && resource.data.inviteeId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if false;
    }
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    match /users/{userId}/blockedUsers/{blockedId} {
      allow read, write: if isOwner(userId);
    }

    function isPartyHost(roomId) {
      return isSignedIn()
        && isValidId(roomId)
        && exists(/databases/$(database)/documents/partyRooms/$(roomId))
        && 'host' in get(/databases/$(database)/documents/partyRooms/$(roomId)).data
        && get(/databases/$(database)/documents/partyRooms/$(roomId)).data.host is map
        && 'id' in get(/databases/$(database)/documents/partyRooms/$(roomId)).data.host
        && get(/databases/$(database)/documents/partyRooms/$(roomId)).data.host.id == request.auth.uid;
    }

    function isValidPartyHeartStat(data) {
      return data.keys().hasAll(['count', 'updatedAt'])
        && data.keys().hasOnly(['count', 'updatedAt'])
        && data.count is number
        && data.count >= 1
        && data.updatedAt == request.time;
    }

    function isValidPartyHeartEvent(data) {
      return data.keys().hasAll(['senderId', 'createdAt'])
        && data.keys().hasOnly(['senderId', 'createdAt'])
        && data.senderId == request.auth.uid
        && data.createdAt == request.time;
    }

    function isValidPartyRoomMessage(data) {
      return data.keys().hasAll(['senderId', 'sender', 'text', 'type', 'createdAt'])
        && data.keys().hasOnly([
          'senderId', 'sender', 'text', 'type', 'createdAt',
          'giftId', 'giftName', 'giftIcon', 'giftCoins', 'quantity', 'recipientId', 'recipientName'
        ])
        && data.senderId == request.auth.uid
        && data.sender is map
        && data.sender.id == request.auth.uid
        && data.sender.displayName is string && data.sender.displayName.size() <= 128
        && data.sender.avatar is string && data.sender.avatar.size() <= 65000
        && data.text is string && data.text.size() <= 2000
        && data.type in ['room', 'host', 'gift', 'system']
        && data.createdAt == request.time
        && (!('giftId' in data) || (data.giftId is string && data.giftId.size() <= 64))
        && (!('giftName' in data) || (data.giftName is string && data.giftName.size() <= 128))
        && (!('giftIcon' in data) || (data.giftIcon is string && data.giftIcon.size() <= 512))
        && (!('giftCoins' in data) || (data.giftCoins is number && data.giftCoins >= 0 && data.giftCoins <= 50000000))
        && (!('quantity' in data) || (data.quantity is number && data.quantity >= 1 && data.quantity <= 9999))
        && (!('recipientId' in data) || (data.recipientId is string && data.recipientId.size() <= 128))
        && (!('recipientName' in data) || (data.recipientName is string && data.recipientName.size() <= 128));
    }

    // Party rooms
    match /partyRooms/{roomId} {
      allow get: if isValidId(roomId) && (isSignedIn() || (resource != null && 'isActive' in resource.data && resource.data.isActive == true));
      allow list: if isSignedIn() || ('isActive' in resource.data && resource.data.isActive == true);
      allow create: if isSignedIn()
        && isValidId(roomId)
        && 'host' in request.resource.data
        && request.resource.data.host is map
        && 'id' in request.resource.data.host
        && request.resource.data.host.id == request.auth.uid
        && isCurrentUserAllowedForParty();
      allow update: if isSignedIn() && isValidId(roomId) && (
        isOfficialAdmin()
        || (
          'host' in resource.data
          && resource.data.host is map
          && 'id' in resource.data.host
          && resource.data.host.id == request.auth.uid
          && (
            ('isActive' in request.resource.data && request.resource.data.isActive == false)
            || isCurrentUserAllowedForParty()
          )
        )
        || (
          roomId == ('party_host_' + request.auth.uid)
          && 'host' in request.resource.data
          && request.resource.data.host is map
          && 'id' in request.resource.data.host
          && request.resource.data.host.id == request.auth.uid
          && isCurrentUserAllowedForParty()
        )
        || (
          'moderatorIds' in resource.data
          && resource.data.moderatorIds is list
          && request.auth.uid in resource.data.moderatorIds
        )
        || (
          isCurrentUserAllowedForParty()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats', 'updatedAt', 'activeViewers', 'totalGiftCoins', 'lastSeenAtMs'])
        )
      );
      allow delete: if isSignedIn() && isValidId(roomId) && (
        isOfficialAdmin()
        || ('host' in resource.data && resource.data.host is map && 'id' in resource.data.host && resource.data.host.id == request.auth.uid)
        || roomId == ('party_host_' + request.auth.uid)
      );

      match /stats/{statId} {
        allow read: if isValidId(roomId) && (isSignedIn() || get(/databases/$(database)/documents/partyRooms/$(roomId)).data.isActive == true);
        allow create: if isSignedIn() && isValidId(roomId) && statId == 'hearts' && isValidPartyHeartStat(request.resource.data) && request.resource.data.count == 1;
        allow update: if isSignedIn() && isValidId(roomId) && statId == 'hearts'
          && isValidPartyHeartStat(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt'])
          && request.resource.data.count == resource.data.count + 1;
        allow delete: if isValidId(statId) && isPartyHost(roomId);
      }
      match /heartEvents/{eventId} {
        allow read: if isValidId(roomId) && (isSignedIn() || get(/databases/$(database)/documents/partyRooms/$(roomId)).data.isActive == true);
        allow create: if isSignedIn() && isValidId(roomId) && isValidId(eventId) && isValidPartyHeartEvent(request.resource.data);
        allow update: if false;
        allow delete: if isValidId(eventId) && isPartyHost(roomId);
      }

      match /messages/{messageId} {
        allow read: if isValidId(roomId) && (isSignedIn() || get(/databases/$(database)/documents/partyRooms/$(roomId)).data.isActive == true);
        allow create: if isSignedIn()
          && isValidId(roomId)
          && isValidId(messageId)
          && isValidPartyRoomMessage(request.resource.data);
        allow update: if false;
        allow delete: if isValidId(messageId) && isPartyHost(roomId);
      }

      match /sessions/{sessionId} {
        allow read, write: if false;

        match /stats/{statId} {
          allow read: if isValidId(roomId) && isValidId(sessionId) && (isSignedIn() || get(/databases/$(database)/documents/partyRooms/$(roomId)).data.isActive == true);
          allow create: if isSignedIn() && isValidId(roomId) && isValidId(sessionId) && statId == 'hearts' && isValidPartyHeartStat(request.resource.data) && request.resource.data.count == 1;
          allow update: if isSignedIn() && isValidId(roomId) && isValidId(sessionId) && statId == 'hearts'
            && isValidPartyHeartStat(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt'])
            && request.resource.data.count == resource.data.count + 1;
          allow delete: if isValidId(sessionId) && isValidId(statId) && isPartyHost(roomId);
        }

        match /heartEvents/{eventId} {
          allow read: if isValidId(roomId) && isValidId(sessionId) && (isSignedIn() || get(/databases/$(database)/documents/partyRooms/$(roomId)).data.isActive == true);
          allow create: if isSignedIn() && isValidId(roomId) && isValidId(sessionId) && isValidId(eventId) && isValidPartyHeartEvent(request.resource.data);
          allow update: if false;
          allow delete: if isValidId(sessionId) && isValidId(eventId) && isPartyHost(roomId);
        }

        match /messages/{messageId} {
          allow read: if isValidId(roomId) && isValidId(sessionId) && (isSignedIn() || get(/databases/$(database)/documents/partyRooms/$(roomId)).data.isActive == true);
          allow create: if isSignedIn()
            && isValidId(roomId)
            && isValidId(sessionId)
            && isValidId(messageId)
            && isValidPartyRoomMessage(request.resource.data);
          allow update: if false;
          allow delete: if isValidId(sessionId) && isValidId(messageId) && isPartyHost(roomId);
        }
      }

      match /signals/{signalId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      match /voiceParticipants/{userId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (
          request.auth.uid == userId
          || isPartyHost(roomId)
          || (
            exists(/databases/$(database)/documents/partyRooms/$(roomId))
            && 'moderatorIds' in get(/databases/$(database)/documents/partyRooms/$(roomId)).data
            && get(/databases/$(database)/documents/partyRooms/$(roomId)).data.moderatorIds is list
            && request.auth.uid in get(/databases/$(database)/documents/partyRooms/$(roomId)).data.moderatorIds
          )
        );
      }

      match /voiceSignals/{pairId}/messages/{messageId} {
        allow read: if isSignedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
        allow write: if false;
      }
    }

    // Live Streams (Solo Live & PK Battle broadcasts)
    match /liveStreams/{streamId} {
      allow get: if isValidId(streamId) && (isSignedIn() || (resource != null && 'isActive' in resource.data && resource.data.isActive == true));
      allow list: if isSignedIn() || ('isActive' in resource.data && resource.data.isActive == true);
      allow create: if isSignedIn()
        && isValidId(streamId)
        && 'host' in request.resource.data
        && request.resource.data.host is map
        && 'id' in request.resource.data.host
        && request.resource.data.host.id == request.auth.uid
        && isCurrentUserAllowedForLive()
        && (!('lastHeartbeat' in request.resource.data) || request.resource.data.lastHeartbeat == request.time);
      allow update: if isSignedIn() && isValidId(streamId) && (
        isOfficialAdmin()
        || (
          'host' in resource.data
          && resource.data.host is map
          && 'id' in resource.data.host
          && resource.data.host.id == request.auth.uid
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastHeartbeat'])
              || request.resource.data.lastHeartbeat == request.time)
        )
        || (
          'moderatorIds' in resource.data
          && resource.data.moderatorIds is list
          && request.auth.uid in resource.data.moderatorIds
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastHeartbeat', 'lastHeartbeatMs'])
        )
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerCount', 'totalGiftCoins', 'updatedAt'])
      );
      allow delete: if isSignedIn() && isValidId(streamId) && (
        isOfficialAdmin()
        || ('host' in resource.data && resource.data.host is map && 'id' in resource.data.host && resource.data.host.id == request.auth.uid)
        || streamId == ('live_host_' + request.auth.uid)
      );

      match /stats/{statId} {
        allow read: if isSignedIn() || get(/databases/$(database)/documents/liveStreams/$(streamId)).data.isActive == true;
        allow create: if isSignedIn() && statId == 'hearts' && request.resource.data.count == 1;
        allow update: if isSignedIn() && statId == 'hearts'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt'])
          && request.resource.data.count == resource.data.count + 1;
      }
      match /heartEvents/{eventId} {
        allow read: if isSignedIn() || get(/databases/$(database)/documents/liveStreams/$(streamId)).data.isActive == true;
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isSignedIn() || get(/databases/$(database)/documents/liveStreams/$(streamId)).data.isActive == true;
        allow create: if isSignedIn()
          && isValidId(streamId)
          && isValidId(messageId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }

      match /viewers/{viewerId} {
        allow read: if isSignedIn() || get(/databases/$(database)/documents/liveStreams/$(streamId)).data.isActive == true;
        allow create, update, delete: if isOwner(viewerId);
      }

      match /signals/{signalId} {
        allow read, write: if false;
      }
    }

    // Alpha Mate Reels (Cloudflare R2 + Firestore integration)
    function isValidReel(data) {
      return data.uid is string && data.uid == request.auth.uid
        && data.videoKey is string && data.videoKey.size() <= 256
        && data.videoUrl is string && data.videoUrl.size() <= 1024
        && data.status in ['active', 'archived', 'deleted']
        && data.visibility in ['public', 'private', 'friends']
        && (!('caption' in data) || (data.caption is string && data.caption.size() <= 2000))
        && (!('title' in data) || (data.title is string && data.title.size() <= 256))
        && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 2048));
    }

    match /reels/{reelId} {
      // Public users may read only active and public reels; owners can read their own reels
      allow get: if (resource.data.status == 'active' && resource.data.visibility == 'public')
                 || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if (resource.data.status == 'active' && resource.data.visibility == 'public')
                  || (isSignedIn() && resource.data.uid == request.auth.uid);

      // Only authenticated users may create reels, document UID must match auth.uid
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isValidReel(request.resource.data);

      // Users may update only their own reel metadata without modifying protected fields (uid, videoKey)
      // Viewers can update interaction counters (likesCount, commentsCount, viewsCount, sharesCount)
      // with strict non-negative numeric bounds (at most +1 or -1 per write).
      allow update: if isSignedIn() && (
        (resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.videoKey == resource.data.videoKey
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'caption', 'thumbnailUrl', 'title', 'tags', 'visibility', 'status',
            'updatedAt', 'likesCount', 'commentsCount', 'viewsCount', 'sharesCount'
          ]))
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likesCount', 'commentsCount', 'viewsCount', 'sharesCount'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['likesCount']) || (
            request.resource.data.likesCount is number
            && request.resource.data.likesCount >= 0
            && request.resource.data.likesCount >= (('likesCount' in resource.data && resource.data.likesCount is number) ? resource.data.likesCount : 0) - 1
            && request.resource.data.likesCount <= (('likesCount' in resource.data && resource.data.likesCount is number) ? resource.data.likesCount : 0) + 1
          ))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentsCount']) || (
            request.resource.data.commentsCount is number
            && request.resource.data.commentsCount >= 0
            && request.resource.data.commentsCount <= (('commentsCount' in resource.data && resource.data.commentsCount is number) ? resource.data.commentsCount : 0) + 1
          ))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewsCount']) || (
            request.resource.data.viewsCount is number
            && request.resource.data.viewsCount >= 0
            && request.resource.data.viewsCount <= (('viewsCount' in resource.data && resource.data.viewsCount is number) ? resource.data.viewsCount : 0) + 1
          ))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sharesCount']) || (
            request.resource.data.sharesCount is number
            && request.resource.data.sharesCount >= 0
            && request.resource.data.sharesCount <= (('sharesCount' in resource.data && resource.data.sharesCount is number) ? resource.data.sharesCount : 0) + 1
          ))
        )
      );

      // Only owner may delete a reel
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Reels Comments subcollection
      match /comments/{commentId} {
        allow read: if (
          exists(/databases/$(database)/documents/reels/$(reelId))
          && get(/databases/$(database)/documents/reels/$(reelId)).data.status == 'active'
          && get(/databases/$(database)/documents/reels/$(reelId)).data.visibility == 'public'
        ) || (
          isSignedIn()
          && exists(/databases/$(database)/documents/reels/$(reelId))
          && get(/databases/$(database)/documents/reels/$(reelId)).data.uid == request.auth.uid
        );
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
        allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // Advanced Multi-Format Gift Animation Catalog (Admin-managed, metadata/URLs only — never raw binaries)
    function isValidAdvancedGift(data, giftId) {
      return data.keys().hasAll([
          'id', 'name', 'coins', 'originalFileUrl', 'animationUrl', 'format',
          'displayMode', 'transparencyStatus', 'opacity', 'durationMs', 'loop',
          'playbackSpeed', 'position', 'scale', 'priority', 'status',
          'conversionStatus', 'createdAt', 'createdAtMs', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'description', 'category', 'coins', 'icon',
          'thumbnailUrl', 'previewImageUrl', 'originalFileUrl', 'optimizedFileUrl',
          'animationUrl', 'format', 'displayMode', 'transparencyStatus', 'opacity',
          'durationMs', 'loop', 'playbackSpeed', 'position', 'scale', 'priority',
          'enableParticles', 'enableSound', 'status', 'conversionStatus',
          'conversionMessage', 'analysis', 'isTestGift', 'createdAt', 'createdAtMs',
          'updatedAt', 'createdBy'
        ])
        && data.id == giftId
        && isNonEmptyString(data.name, 1, 100)
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('category' in data) || (data.category is string && data.category.size() <= 64))
        && data.coins is number && data.coins >= 1 && data.coins <= 10000000
        && (!('icon' in data) || (data.icon is string && data.icon.size() <= 32))
        && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 2048))
        && (!('previewImageUrl' in data) || (data.previewImageUrl is string && data.previewImageUrl.size() <= 2048))
        && isNonEmptyString(data.originalFileUrl, 1, 2048)
        && (!('optimizedFileUrl' in data) || (data.optimizedFileUrl is string && data.optimizedFileUrl.size() <= 2048))
        && isNonEmptyString(data.animationUrl, 1, 2048)
        && data.format in ['webm', 'mov', 'mp4', 'svg', 'gif']
        && data.displayMode in ['transparent', 'semi_transparent', 'overlay_background']
        && data.transparencyStatus in ['alpha_verified', 'alpha_limited_gif', 'opaque_no_alpha', 'unknown']
        && data.opacity is number && data.opacity >= 10 && data.opacity <= 100
        && data.durationMs is number && data.durationMs >= 1500 && data.durationMs <= 60000
        && data.loop is bool
        && data.playbackSpeed is number && data.playbackSpeed >= 0.5 && data.playbackSpeed <= 2.0
        && data.position in ['center', 'top', 'bottom', 'fullscreen']
        && data.scale is number && data.scale >= 0.4 && data.scale <= 1.5
        && data.priority is number && data.priority >= 1 && data.priority <= 100
        && (!('enableParticles' in data) || data.enableParticles is bool)
        && (!('enableSound' in data) || data.enableSound is bool)
        && data.status in ['draft', 'processing', 'published', 'disabled']
        && data.conversionStatus in ['not_needed', 'pending', 'converting', 'completed', 'failed', 'unsupported']
        && (!('conversionMessage' in data) || (data.conversionMessage is string && data.conversionMessage.size() <= 500))
        && (!('analysis' in data) || data.analysis is map)
        && (!('isTestGift' in data) || data.isTestGift is bool)
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.createdAtMs is number
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128));
    }

    match /advancedGifts/{giftId} {
      allow get: if isValidId(giftId) && (
        isOfficialAdmin()
        || (isSignedIn() && resource != null && resource.data.status == 'published')
      );
      allow list: if isOfficialAdmin() || isSignedIn();
      allow create, update: if isValidId(giftId)
        && isOfficialAdmin()
        && isValidAdvancedGift(request.resource.data, giftId);
      allow delete: if isValidId(giftId) && isOfficialAdmin();
    }
  }
}

