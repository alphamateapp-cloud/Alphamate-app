# Railway backend private variables (set in Railway dashboard, NOT in this frontend .env):
# FIREBASE_API_KEY=<Firebase Web API key used to validate ID tokens>
# CLOUDFLARE_TURN_TOKEN_ID=<Cloudflare Realtime TURN Token/Key ID>
# CLOUDFLARE_TURN_KEY_ID=<Optional alias for CLOUDFLARE_TURN_TOKEN_ID>
# CLOUDFLARE_TURN_API_TOKEN=<Cloudflare API token with TURN credential generation permission>
# TURN_CREDENTIAL_TTL=3600
# REALTIME_SFU_APP_ID=<Cloudflare Realtime SFU App ID (Solo Live WebRTC ONLY)>
# REALTIME_SFU_BEARER_TOKEN=<Cloudflare Realtime SFU API Token / Bearer Credential (Solo Live WebRTC ONLY)>
# AGORA_APP_ID=<Agora App ID (Party Rooms RTC ONLY — never use VITE_ prefix)>
# AGORA_APP_CERTIFICATE=<Agora Primary Certificate (Party Rooms RTC ONLY — strictly server-side)>
# AGORA_TOKEN_TTL_SECONDS=3600
# Admin API access (private Railway variables; never use VITE_ prefix)
# FIREBASE_PROJECT_ID=gen-lang-client-0468444352
# FIREBASE_DATABASE_ID=ai-studio-alphamatelivepar-88a3637b-56a3-47f2-a3ab-b67bf1702cff
# FIREBASE_SERVICE_ACCOUNT_JSON=<complete service-account JSON for this same Firebase project>
# ADMIN_EMAILS=alphamateapp@gmail.com
# ALLOWED_ORIGINS=https://your-app-domain,https://your-admin-domain
#
# Server-Side Resend Email OTP Secret (NEVER use VITE_ prefix; NEVER commit real keys):
# AI Studio automatically prompts/injects RESEND_API_KEY from Settings -> Secrets.
# On Railway (https://api.alphamate.app), set RESEND_API_KEY in Railway Service -> Variables.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Alpha Mate <no-reply@alphamate.app>"

