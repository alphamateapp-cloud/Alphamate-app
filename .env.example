# WebRTC credentials are issued by the Railway backend; never put private TURN keys in VITE_ variables.
VITE_RAILWAY_API_URL="https://YOUR-RAILWAY-DOMAIN.up.railway.app"

# Railway backend private variables (set in Railway dashboard, NOT in this frontend .env):
# FIREBASE_API_KEY=<Firebase Web API key used to validate ID tokens>
# CLOUDFLARE_TURN_KEY_ID=<Cloudflare Calls TURN key ID>
# CLOUDFLARE_TURN_API_TOKEN=<Cloudflare API token with Calls TURN credential permission>
# TURN_CREDENTIAL_TTL=3600
# REALTIME_SFU_APP_ID=<Cloudflare Realtime SFU App ID>
# REALTIME_SFU_BEARER_TOKEN=<Cloudflare Realtime SFU App Secret / Bearer Token>
# ALLOWED_ORIGINS=https://your-app-domain
