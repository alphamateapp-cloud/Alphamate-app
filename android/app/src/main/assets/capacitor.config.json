{
	"appId": "com.alphamate.liveparty",
	"appName": "Alpha Mate",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": true,
		"backgroundColor": "#09070F"
	},
	"plugins": {
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#09070F"
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	}
}
