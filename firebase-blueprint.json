        "maxDailyStreak": { "type": "number" },
        "postsCreatedCount": { "type": "number" },
        "equippedBadgeIds": { "type": "array" },
        "earnedBadges": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedAtMs": { "type": "number" }
      },
      "required": [
        "uid",
        "totalGiftCoinsSent",
        "totalGiftsSentCount",
        "totalGiftCoinsReceived",
        "totalDiamondsEarned",
        "totalActiveMinutes",
        "partyRoomMinutes",
        "liveStreamMinutes",
