{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and account information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uniqueId": { "type": "string", "maxLength": 64 },
        "username": { "type": "string", "maxLength": 64 },
        "displayName": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "avatar": { "type": "string", "maxLength": 1024 },
        "bio": { "type": "string", "maxLength": 512 },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "likesCount": { "type": "number" },
        "level": { "type": "number" },
        "xp": { "type": "number" },
        "nextLevelXp": { "type": "number" },
        "vipTier": { "type": "number" },
        "coins": { "type": "number" },
        "diamonds": { "type": "number" },
        "accountStatus": { "type": "string", "enum": ["active", "deactivated", "pending_deletion", "permanently_deleted"] },
        "deactivatedAt": { "type": "string", "format": "date-time" },
        "deletionRequestedAt": { "type": "string", "format": "date-time" },
        "scheduledPermanentDeletionAt": { "type": "string", "format": "date-time" },
        "pushNotificationToken": { "type": "string", "maxLength": 512 },
        "pushPlatform": { "type": "string", "enum": ["android", "ios", "web"] },
        "pushLastActiveAt": { "type": "string", "format": "date-time" },
        "notificationPreferences": { "type": "object" },
        "equippedBadgeIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "displayName", "level", "vipTier", "coins", "diamonds"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Real-time per-user notification item backed by Firestore and FCM push triggers",
      "type": "object",
      "properties": {
        "recipientId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 128 },
        "senderAvatar": { "type": "string", "maxLength": 1024 },
        "type": {
          "type": "string",
          "enum": ["live_on", "party_invite", "friend_request", "follow", "gift", "comment", "message", "like", "pk_invite", "wallet", "agency", "system"]
        },
        "category": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 160 },
        "message": { "type": "string", "maxLength": 600 },
        "screen": { "type": "string", "maxLength": 64 },
        "tab": { "type": "string", "maxLength": 64 },
        "roomId": { "type": "string", "maxLength": 128 },
        "streamId": { "type": "string", "maxLength": 128 },
        "reelId": { "type": "string", "maxLength": 128 },
        "chatId": { "type": "string", "maxLength": 128 },
        "isRead": { "type": "boolean" },
        "readAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdAtMs": { "type": "number" }
      },
      "required": ["recipientId", "senderId", "type", "title", "message", "isRead", "createdAt", "createdAtMs"]
    },
    "GiftTransaction": {
      "title": "GiftTransaction",
      "description": "Immutable 60/40 gifting ledger: 60% host Diamonds + 40% App Revenue Share",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 128 },
        "recipientId": { "type": "string", "maxLength": 128 },
        "recipientName": { "type": "string", "maxLength": 128 },
        "giftId": { "type": "string", "maxLength": 64 },
        "giftName": { "type": "string", "maxLength": 80 },
        "giftIcon": { "type": "string", "maxLength": 32 },
        "quantity": { "type": "number" },
        "totalCoins": { "type": "number" },
        "hostDiamonds": { "type": "number" },
        "appShareCoins": { "type": "number" },
        "context": { "type": "string", "enum": ["live", "party", "moments", "pk", "demo"] },
        "roomId": { "type": "string", "maxLength": 128 },
        "streamId": { "type": "string", "maxLength": 128 },
        "reelId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["completed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdAtMs": { "type": "number" }
      },
      "required": ["senderId", "recipientId", "giftId", "giftName", "quantity", "totalCoins", "hostDiamonds", "appShareCoins", "context", "status", "createdAt", "createdAtMs"]
    },
    "PartyRoom": {
      "title": "PartyRoom",
      "description": "Real-time Audio Party Room details and seat layout",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 128 },
        "hostId": { "type": "string", "maxLength": 128 },
        "hostName": { "type": "string", "maxLength": 64 },
        "hostAvatar": { "type": "string", "maxLength": 1024 },
        "category": { "type": "string", "maxLength": 64 },
        "level": { "type": "number" },
        "activeViewers": { "type": "number" },
        "totalGiftCoins": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "hostId", "category", "level"]
    },
    "RoomMessage": {
      "title": "RoomMessage",
      "description": "Chat and gift message within a Party Room",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "roomId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 64 },
        "senderAvatar": { "type": "string", "maxLength": 1024 },
        "text": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "roomId", "senderId", "senderName", "text"]
    },
    "LiveStream": {
      "title": "LiveStream",
      "description": "Active solo and PK video live streams",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 128 },
        "hostId": { "type": "string", "maxLength": 128 },
        "hostName": { "type": "string", "maxLength": 64 },
        "hostAvatar": { "type": "string", "maxLength": 1024 },
        "viewerCount": { "type": "number" },
        "category": { "type": "string", "maxLength": 64 },
        "isActive": { "type": "boolean" },
        "isPK": { "type": "boolean" },
        "sfuSessionId": { "type": "string", "maxLength": 256 },
        "isVideoOn": { "type": "boolean" },
        "isMicOn": { "type": "boolean" },
        "lastHeartbeat": { "type": "string", "format": "date-time" },
        "lastHeartbeatMs": { "type": "number" },
        "lastSeenAt": { "type": "string", "format": "date-time" },
        "lastSeenAtMs": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "hostId"]
    },
    "Reel": {
      "title": "Reel",
      "description": "Short-form video reel uploaded to Cloudflare R2 and indexed in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "videoKey": { "type": "string", "maxLength": 256 },
        "videoUrl": { "type": "string", "maxLength": 1024 },
        "caption": { "type": "string", "maxLength": 2000 },
        "thumbnailUrl": { "type": "string", "maxLength": 2048 },
        "title": { "type": "string", "maxLength": 256 },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "viewsCount": { "type": "number" },
        "visibility": { "type": "string", "enum": ["public", "private", "friends"] },
        "status": { "type": "string", "enum": ["active", "archived", "deleted"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "videoKey", "videoUrl", "status", "visibility"]
    },
    "HeartStat": {
      "title": "HeartStat",
      "description": "Shared real-time heart count for a live stream or party room",
      "type": "object",
      "properties": {
        "count": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["count"]
    },
    "HeartEvent": {
      "title": "HeartEvent",
      "description": "Double-tap heart event dispatched inside a live stream or party room",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId"]
    },
    "LiveViewer": {
      "title": "LiveViewer",
      "description": "Active viewer presence in a Solo Live stream",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uniqueId": { "type": "string", "maxLength": 64 },
        "displayName": { "type": "string", "maxLength": 64 },
        "avatar": { "type": "string", "maxLength": 1024 },
        "level": { "type": "number" },
        "vipTier": { "type": "number" },
        "lastSeenAtMs": { "type": "number" }
      },
      "required": ["id", "displayName"]
    },
    "VoiceParticipant": {
      "title": "VoiceParticipant",
      "description": "Active speaker/listener WebRTC SFU state in a Party Room",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 64 },
        "sfuSessionId": { "type": "string", "maxLength": 256 },
        "isPublishing": { "type": "boolean" },
        "isMuted": { "type": "boolean" },
        "isSpeaking": { "type": "boolean" },
        "lastSeenAtMs": { "type": "number" }
      },
      "required": ["userId", "sfuSessionId"]
    },
    "AccountDeletionRequest": {
      "title": "AccountDeletionRequest",
      "description": "Account temporary deactivation and OTP-verified 15-day permanent deletion queue records",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "uniqueId": { "type": "string", "maxLength": 64 },
        "username": { "type": "string", "maxLength": 64 },
        "displayName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "avatar": { "type": "string", "maxLength": 1024 },
        "type": { "type": "string", "enum": ["deactivation", "permanent_delete"] },
        "status": { "type": "string", "enum": ["deactivated", "pending_official_deletion", "recovered", "permanently_deleted"] },
        "otpVerified": { "type": "boolean" },
        "otpVerifiedAt": { "type": "string", "format": "date-time" },
        "requestedAt": { "type": "string", "format": "date-time" },
        "scheduledPermanentDeletionAt": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "maxLength": 500 },
        "recoveredAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "type", "status", "requestedAt", "updatedAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Monthly-resetting Global & Weekly leaderboard ranking record tracking received gifts and active time spent for 100+ users",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "uniqueId": { "type": "string", "maxLength": 64 },
        "displayName": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "avatar": { "type": "string", "maxLength": 2048 },
        "countryFlag": { "type": "string", "maxLength": 16 },
        "level": { "type": "number" },
        "vipTier": { "type": "number" },
        "monthKey": { "type": "string", "maxLength": 16 },
        "weekKey": { "type": "string", "maxLength": 16 },
        "receivedGiftCoins": { "type": "number" },
        "receivedDiamonds": { "type": "number" },
        "giftsCount": { "type": "number" },
        "timeSpentMinutes": { "type": "number" },
        "score": { "type": "number" },
        "weeklyGiftCoins": { "type": "number" },
        "weeklyDiamonds": { "type": "number" },
        "weeklyGiftsCount": { "type": "number" },
        "weeklyTimeSpentMinutes": { "type": "number" },
        "weeklyScore": { "type": "number" },
        "equippedBadgeIds": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedAtMs": { "type": "number" }
      },
      "required": [
        "uid",
        "displayName",
        "monthKey",
        "weekKey",
        "receivedGiftCoins",
        "receivedDiamonds",
        "giftsCount",
        "timeSpentMinutes",
        "score",
        "weeklyGiftCoins",
        "weeklyDiamonds",
        "weeklyGiftsCount",
        "weeklyTimeSpentMinutes",
        "weeklyScore",
        "updatedAt",
        "updatedAtMs"
      ]
    },
    "UserBadgeStats": {
      "title": "UserBadgeStats",
      "description": "Historical achievement metrics, unlocked User Badges, and equipped profile icons for a user",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "totalGiftCoinsSent": { "type": "number" },
        "totalGiftsSentCount": { "type": "number" },
        "totalGiftCoinsReceived": { "type": "number" },
        "totalDiamondsEarned": { "type": "number" },
        "totalActiveMinutes": { "type": "number" },
        "partyRoomMinutes": { "type": "number" },
        "liveStreamMinutes": { "type": "number" },
        "longestPartySessionMinutes": { "type": "number" },
        "bestLeaderboardRank": { "type": "number" },
        "checkInDaysCount": { "type": "number" },
        "maxDailyStreak": { "type": "number" },
        "postsCreatedCount": { "type": "number" },
        "equippedBadgeIds": { "type": "array" },
        "earnedBadges": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedAtMs": { "type": "number" }
      },
      "required": [
        "uid",
        "totalGiftCoinsSent",
        "totalGiftsSentCount",
        "totalGiftCoinsReceived",
        "totalDiamondsEarned",
        "totalActiveMinutes",
        "partyRoomMinutes",
        "liveStreamMinutes",
        "longestPartySessionMinutes",
        "checkInDaysCount",
        "maxDailyStreak",
        "postsCreatedCount",
        "equippedBadgeIds",
        "earnedBadges",
        "updatedAt",
        "updatedAtMs"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents keyed by Firebase auth UID"
    },
    "/users/{userId}/badgeStats/{docId}": {
      "schema": "UserBadgeStats",
      "description": "Historical achievement counters, earned User Badges, and equipped profile badge icons"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Real-time user notifications inbox scoped per recipient UID"
    },
    "/giftTransactions/{txId}": {
      "schema": "GiftTransaction",
      "description": "60/40 gifting transactions (60% host Diamonds, 40% App share)"
    },
    "/accountDeletionRequests/{requestId}": {
      "schema": "AccountDeletionRequest",
      "description": "Official account deactivation and 15-day pending permanent deletion records keyed by Firebase auth UID"
    },
    "/leaderboardMonths/{monthKey}/entries/{userId}": {
      "schema": "LeaderboardEntry",
      "description": "Monthly-partitioned Global & Weekly leaderboard records holding 100+ users per monthKey (YYYY-MM)"
    },
    "/reels/{reelId}": {
      "schema": "Reel",
      "description": "Public and user video reels metadata"
    },
    "/partyRooms/{roomId}": {
      "schema": "PartyRoom",
      "description": "Active audio party rooms"
    },
    "/partyRooms/{roomId}/messages/{messageId}": {
      "schema": "RoomMessage",
      "description": "Chat messages inside a party room"
    },
    "/partyRooms/{roomId}/stats/{statId}": {
      "schema": "HeartStat",
      "description": "Shared heart counter for a party room"
    },
    "/partyRooms/{roomId}/heartEvents/{eventId}": {
      "schema": "HeartEvent",
      "description": "Double-tap heart events inside a party room"
    },
    "/partyRooms/{roomId}/voiceParticipants/{userId}": {
      "schema": "VoiceParticipant",
      "description": "SFU audio presence for a party room participant"
    },
    "/liveStreams/{streamId}": {
      "schema": "LiveStream",
      "description": "Active live video broadcasts"
    },
    "/liveStreams/{streamId}/stats/{statId}": {
      "schema": "HeartStat",
      "description": "Shared heart counter for a live stream"
    },
    "/liveStreams/{streamId}/heartEvents/{eventId}": {
      "schema": "HeartEvent",
      "description": "Double-tap heart events inside a live stream"
    },
    "/liveStreams/{streamId}/viewers/{viewerId}": {
      "schema": "LiveViewer",
      "description": "Active viewers inside a Solo Live stream"
    }
  }
}
