{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.js",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:release-apk": "vite build && cap sync android && cd android && ./gradlew assembleRelease",
    "android:aab": "vite build && cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/status-bar": "^8.0.4",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
